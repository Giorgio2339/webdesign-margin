# =============================================================
# MARGIN. — Apache config for GoDaddy shared hosting
# Lands in dist/ automatically (Vite copies public/ verbatim).
#
# If the site is ever served through Cloudflare Pages or another
# non-Apache host, translate these into that host's header rules —
# this file is ignored there.
# =============================================================

# ---------- Security headers ----------
<IfModule mod_headers.c>
  # No MIME sniffing.
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking: frame-ancestors below is the modern control;
  # X-Frame-Options stays for older browsers that ignore CSP.
  Header always set X-Frame-Options "DENY"

  # Send only the origin cross-site — keeps paths out of referrers.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nothing here needs camera, mic, geolocation or payment.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content-Security-Policy
  #
  #   script-src  'self' + two SHA-256 hashes for the inline blocks in
  #               index.html (the js-motion toggle and the JSON-LD).
  #               No 'unsafe-inline', no 'unsafe-eval'.
  #   style-src   needs 'unsafe-inline': the markup carries a handful of
  #               inline style attributes. CSSOM writes from GSAP are not
  #               covered by CSP at all, so this does not weaken motion.
  #   connect-src / form-action  only the Web3Forms endpoint.
  #
  # !! If you edit either inline <script> in index.html (changing the
  #    domain in the JSON-LD counts), the matching hash MUST be updated
  #    or that block is silently blocked. Regenerate with:
  #
  #    python3 -c "import re,hashlib,base64;s=open('index.html',encoding='utf-8').read();[print('sha256-'+base64.b64encode(hashlib.sha256(m.group(2).encode()).digest()).decode()) for m in re.finditer(r'<script(?![^>]*\bsrc=)([^>]*)>(.*?)</script>',s,re.S)]"
  #
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0Etx0bks/ohwttZlMZhd1BxYZGjJtT4YeEq+3lBFAek=' 'sha256-2KkHGBvsVz2GsLM8QB9NNvfkTkph5+de//seLtCNKF0='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"

  # HSTS — only meaningful once HTTPS is confirmed working on every
  # hostname (apex + www). Two years, subdomains included, preload-ready.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ---------- Force HTTPS + canonical host ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Behind Cloudflare the origin often sees plain HTTP, so trust the
  # forwarding header as well as Apache's own HTTPS flag.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # One canonical host: strip www. Drop this block if www is preferred.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite fingerprints these, so they can be cached hard.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts never change under the same name either.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images keep stable names, so cache for a month and revalidate.
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"

  # HTML must always be revalidated or deploys go unnoticed.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Error page ----------
ErrorDocument 404 /404.html

# ---------- Don't serve dotfiles ----------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
